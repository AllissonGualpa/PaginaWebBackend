<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= title %></title>
    
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <div class="container mt-4">
        <h1 class="text-center mb-4">🌤️ Registros del Clima</h1>
        
        <div class="table-responsive">
            <table class="table table-striped table-bordered">
                <thead class="table-dark">
                    <tr>
                        <th>Ciudad</th>
                        <th>Temperatura</th>
                        <th>Humedad</th>
                        <th>Viento</th>
                        <th>Estado</th>
                        <th>Ícono</th>
                    </tr>
                </thead>
                <tbody>
                    <% arrClima.forEach(registro => { %>
                        <tr>
                            <td><%= registro.ciudad %></td>
                            <td><%= registro.temperatura %>°C</td>
                            <td><%= registro.humedad %>%</td>
                            <td><%= registro.viento %> m/s</td>
                            <td><%= registro.descripcion %></td>
                            <td>
                                <img src="https://openweathermap.org/img/wn/<%= registro.icono %>@2x.png" 
                                     alt="icono del clima" class="img-fluid">
                            </td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
